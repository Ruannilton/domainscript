// listEntriesPerIpLimiter é o limitador perIp de GET "/wallets/{id}/entries" -> ListEntries (spec §16, G4).
var listEntriesPerIpLimiterRedisClient, listEntriesPerIpLimiterRedisClientErr = redisruntime.OpenClient(os.Getenv("WALLET_REDIS_URL"))
var listEntriesPerIpLimiter runtime.Limiter = newListEntriesPerIpLimiter()

// newListEntriesPerIpLimiter resolve o backend do limitador com FALLBACK LOCAL na abertura da
// conexão (REQ-44.5): um Redis fora do ar NUNCA derruba o processo — o
// limitador degrada para o in-process (proteção por-réplica em vez de
// global, exatamente o fallback que redisruntime.Allow já aplica para uma
// falha DEPOIS de conectado; ver a doc de redisrt/ratelimit.go.txt). Note
// que rate limit NÃO é fail-open total, ao contrário do cache: continuar
// limitando localmente é o ponto — desligar a proteção seria pior que
// limitar por réplica.
func newListEntriesPerIpLimiter() runtime.Limiter {
	if listEntriesPerIpLimiterRedisClientErr != nil {
		slog.Error("rate limit: Redis indisponível na abertura — usando fallback local por-réplica (REQ-44.5)", "limiter", "listEntriesPerIpLimiter", "error", listEntriesPerIpLimiterRedisClientErr)
		return runtime.NewLimiter("token_bucket", 1200, time.Duration(60000000000), 0)
	}
	return redisruntime.NewRedisLimiter(listEntriesPerIpLimiterRedisClient, "listEntriesPerIpLimiter", "token_bucket", 1200, time.Duration(60000000000), 0)
}

// listEntriesPerUserLimiter é o limitador perUser de GET "/wallets/{id}/entries" -> ListEntries (spec §16, G4).
var listEntriesPerUserLimiterRedisClient, listEntriesPerUserLimiterRedisClientErr = redisruntime.OpenClient(os.Getenv("WALLET_REDIS_URL"))
var listEntriesPerUserLimiter runtime.Limiter = newListEntriesPerUserLimiter()

// newListEntriesPerUserLimiter resolve o backend do limitador com FALLBACK LOCAL na abertura da
// conexão (REQ-44.5): um Redis fora do ar NUNCA derruba o processo — o
// limitador degrada para o in-process (proteção por-réplica em vez de
// global, exatamente o fallback que redisruntime.Allow já aplica para uma
// falha DEPOIS de conectado; ver a doc de redisrt/ratelimit.go.txt). Note
// que rate limit NÃO é fail-open total, ao contrário do cache: continuar
// limitando localmente é o ponto — desligar a proteção seria pior que
// limitar por réplica.
func newListEntriesPerUserLimiter() runtime.Limiter {
	if listEntriesPerUserLimiterRedisClientErr != nil {
		slog.Error("rate limit: Redis indisponível na abertura — usando fallback local por-réplica (REQ-44.5)", "limiter", "listEntriesPerUserLimiter", "error", listEntriesPerUserLimiterRedisClientErr)
		return runtime.NewLimiter("token_bucket", 120, time.Duration(60000000000), 0)
	}
	return redisruntime.NewRedisLimiter(listEntriesPerUserLimiterRedisClient, "listEntriesPerUserLimiter", "token_bucket", 120, time.Duration(60000000000), 0)
}

// listEntriesRateLimitChecks monta as dimensões de rate limit de GET "/wallets/{id}/entries" -> ListEntries (spec §16, G4).
func listEntriesRateLimitChecks(ctx context.Context, r *http.Request) []runtime.RateLimitCheck {
	var checks []runtime.RateLimitCheck
	checks = append(checks, runtime.RateLimitCheck{Limiter: listEntriesPerIpLimiter, Key: rateLimitClientIP(r), FailOpen: true})
	if caller, ok := runtime.CallerFrom(ctx); ok && caller.Authenticated() {
		checks = append(checks, runtime.RateLimitCheck{Limiter: listEntriesPerUserLimiter, Key: caller.ID(), FailOpen: true})
	}
	return checks
}
