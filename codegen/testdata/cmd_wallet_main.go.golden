// limitar por réplica.
func newPerformDepositPerUserLimiter() runtime.Limiter {
	if performDepositPerUserLimiterRedisClientErr != nil {
		slog.Error("rate limit: Redis indisponível na abertura — usando fallback local por-réplica (REQ-44.5)", "limiter", "performDepositPerUserLimiter", "error", performDepositPerUserLimiterRedisClientErr)
		return runtime.NewLimiter("token_bucket", 60, time.Duration(60000000000), 10)
	}
	return redisruntime.NewRedisLimiter(performDepositPerUserLimiterRedisClient, "performDepositPerUserLimiter", "token_bucket", 60, time.Duration(60000000000), 10)
}

// performDepositRateLimitChecks monta as dimensões de rate limit de POST "/wallets/{id}/deposit" -> PerformDeposit (spec §16, G4).
func performDepositRateLimitChecks(ctx context.Context, r *http.Request) []runtime.RateLimitCheck {
	var checks []runtime.RateLimitCheck
	checks = append(checks, runtime.RateLimitCheck{Limiter: performDepositPerIpLimiter, Key: rateLimitClientIP(r), FailOpen: true})
	if caller, ok := runtime.CallerFrom(ctx); ok && caller.Authenticated() {
		checks = append(checks, runtime.RateLimitCheck{Limiter: performDepositPerUserLimiter, Key: caller.ID(), FailOpen: true})
	}
	return checks
}

